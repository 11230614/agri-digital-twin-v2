{
  "name": "agri-digital-twin-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "node scripts/prepare-cesium.mjs && vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
